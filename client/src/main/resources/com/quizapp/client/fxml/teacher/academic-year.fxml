<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.quizapp.client.controller.teacher.AcademicYearController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Manage Academic Years" />
    <TextField fx:id="startYearField" maxWidth="320" promptText="Start year, e.g. 2026" />
    <CheckBox fx:id="activeCheckBox" mnemonicParsing="false" text="Set as active" />
    <Button mnemonicParsing="false" onAction="#handleCreateAcademicYear" text="Create academic year" />
    <ListView fx:id="academicYearList" maxHeight="280" maxWidth="420" prefHeight="260" prefWidth="420" />
    <Button mnemonicParsing="false" onAction="#handleBack" text="Back" />
    <Label fx:id="statusLabel" wrapText="true" />
</VBox>
