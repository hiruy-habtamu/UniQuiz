<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.quizapp.client.controller.teacher.SemesterController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Create Semester" />
    <TextField fx:id="academicYearIdField" maxWidth="320" promptText="Academic year id" />
    <TextField fx:id="nameField" maxWidth="320" promptText="Name: FIRST, SECOND, or SUMMER" />
    <DatePicker fx:id="startDatePicker" maxWidth="320" promptText="Start date" />
    <DatePicker fx:id="endDatePicker" maxWidth="320" promptText="End date" />
    <CheckBox fx:id="activeCheckBox" mnemonicParsing="false" text="Set as active" />
    <Button mnemonicParsing="false" onAction="#handleCreateSemester" text="Create semester" />
    <Button mnemonicParsing="false" onAction="#handleBack" text="Back" />
    <Label fx:id="statusLabel" wrapText="true" />
</VBox>
