<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.quizapp.client.controller.teacher.SectionController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Create Section" />
    <ComboBox fx:id="batchComboBox" maxWidth="320" promptText="Select batch" />
    <ListView fx:id="batchListView" maxHeight="120" maxWidth="420" prefHeight="100" prefWidth="420" />
    <ComboBox fx:id="semesterComboBox" maxWidth="320" promptText="Select semester" />
    <TextField fx:id="sectionNameField" maxWidth="320" promptText="Section name, e.g. A" />
    <Button mnemonicParsing="false" onAction="#handleCreateSection" text="Create section" />
    <ListView fx:id="sectionListView" maxHeight="220" maxWidth="420" prefHeight="200" prefWidth="420" />
    <Button mnemonicParsing="false" onAction="#handleBack" text="Back" />
    <Label fx:id="statusLabel" wrapText="true" />
</VBox>
