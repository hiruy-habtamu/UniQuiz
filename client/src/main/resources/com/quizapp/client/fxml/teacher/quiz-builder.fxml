<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.quizapp.client.controller.teacher.QuizBuilderController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Quiz Builder" />
    <ComboBox fx:id="academicYearComboBox" maxWidth="360" promptText="Select academic year" />
    <ComboBox fx:id="semesterComboBox" maxWidth="360" promptText="Select semester" />
    <TextField fx:id="titleField" maxWidth="360" promptText="Quiz title" />
    <Label text="Time limit (seconds)" />
    <Spinner fx:id="timeLimitSpinner" maxWidth="360" />
    <Label text="Passing score (%)" />
    <Spinner fx:id="passingScoreSpinner" maxWidth="360" />
    <TextArea fx:id="questionBodyArea" maxWidth="520" prefRowCount="3" promptText="Question body" />
    <TextField fx:id="choiceAField" maxWidth="420" promptText="Choice A" />
    <TextField fx:id="choiceBField" maxWidth="420" promptText="Choice B" />
    <TextField fx:id="choiceCField" maxWidth="420" promptText="Choice C (optional)" />
    <TextField fx:id="choiceDField" maxWidth="420" promptText="Choice D (optional)" />
    <ComboBox fx:id="correctChoiceComboBox" maxWidth="220" promptText="Correct choice" />
    <Button mnemonicParsing="false" onAction="#handleAddQuestion" text="Add Question" />
    <Button mnemonicParsing="false" onAction="#handleRemoveSelectedQuestion" text="Remove Selected Draft Question" />
    <ListView fx:id="draftedQuestionsList" maxHeight="220" maxWidth="520" prefHeight="200" prefWidth="520" />
    <Button mnemonicParsing="false" onAction="#handleCreateQuiz" text="Create Quiz" />
    <Button mnemonicParsing="false" onAction="#handleBack" text="Back" />
    <Label fx:id="statusLabel" wrapText="true" />
</VBox>
