<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane prefHeight="640.0" prefWidth="960.0" styleClass="screen-root"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.quizapp.client.controller.teacher.QuizBuilderController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="screen-root">
        <content>
            <VBox alignment="TOP_CENTER" spacing="16">
                <VBox maxWidth="760" spacing="16" styleClass="card">
                    <padding>
                        <Insets top="28" right="28" bottom="28" left="28"/>
                    </padding>
                    <Label styleClass="page-title" text="Quiz Builder" />
                    <Label styleClass="subtitle-text" text="Create draft quizzes for active semesters, then activate them later from the session manager." wrapText="true" />
                    <VBox spacing="12" styleClass="form-section-card">
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>
                        <Label styleClass="section-title" text="Quiz Settings" />
                        <Label styleClass="muted-text" text="Academic Year" />
                        <ComboBox fx:id="academicYearComboBox" maxWidth="Infinity" promptText="Select academic year" />
                        <Label styleClass="muted-text" text="Semester" />
                        <ComboBox fx:id="semesterComboBox" maxWidth="Infinity" promptText="Select active semester" />
                        <Label styleClass="muted-text" text="Quiz Title" />
                        <TextField fx:id="titleField" maxWidth="Infinity" promptText="Quiz title" />
                        <Label styleClass="muted-text" text="Time limit (seconds)" />
                        <Spinner fx:id="timeLimitSpinner" maxWidth="Infinity" />
                        <Label styleClass="muted-text" text="Passing score (%)" />
                        <Spinner fx:id="passingScoreSpinner" maxWidth="Infinity" />
                    </VBox>
                    <VBox spacing="12" styleClass="form-section-card">
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>
                        <Label styleClass="section-title" text="Question Editor" />
                        <TextArea fx:id="questionBodyArea" maxWidth="Infinity" prefRowCount="3" promptText="Question body" />
                        <TextField fx:id="choiceAField" maxWidth="Infinity" promptText="Choice A" />
                        <TextField fx:id="choiceBField" maxWidth="Infinity" promptText="Choice B" />
                        <TextField fx:id="choiceCField" maxWidth="Infinity" promptText="Choice C (optional)" />
                        <TextField fx:id="choiceDField" maxWidth="Infinity" promptText="Choice D (optional)" />
                        <ComboBox fx:id="correctChoiceComboBox" maxWidth="260" promptText="Correct choice" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleAddQuestion" styleClass="secondary-button" text="Add Question" />
                    </VBox>
                    <VBox spacing="12" styleClass="form-section-card">
                        <padding>
                            <Insets top="18" right="18" bottom="18" left="18"/>
                        </padding>
                        <Label styleClass="section-title" text="Draft Questions" />
                        <ListView fx:id="draftedQuestionsList" maxHeight="240" prefHeight="220" prefWidth="680" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleRemoveSelectedQuestion" styleClass="ghost-button" text="Remove Selected Draft Question" />
                    </VBox>
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleCreateQuiz" styleClass="primary-button" text="Create Quiz" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleBack" styleClass="secondary-button" text="Back" />
                    <Label fx:id="statusLabel" styleClass="status-text" wrapText="true" />
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</StackPane>
