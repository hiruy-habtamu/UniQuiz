<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.quizapp.client.controller.RegisterController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="UniQuiz Register" />
    <TextField fx:id="fullNameField" maxWidth="320" promptText="Full name" />
    <TextField fx:id="usernameField" maxWidth="320" promptText="Username" />
    <PasswordField fx:id="passwordField" maxWidth="320" promptText="Password" />
    <ComboBox fx:id="roleComboBox" maxWidth="320" promptText="Role" />
    <ComboBox fx:id="batchComboBox" maxWidth="320" promptText="Select batch" />
    <ComboBox fx:id="sectionComboBox" maxWidth="320" promptText="Select section" />
    <Button mnemonicParsing="false" onAction="#handleRegister" text="Register" />
    <Button mnemonicParsing="false" onAction="#handleGoToLogin" text="Back to login" />
    <Label fx:id="statusLabel" wrapText="true" />
</VBox>
