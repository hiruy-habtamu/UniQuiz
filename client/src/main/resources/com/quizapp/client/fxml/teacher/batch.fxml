<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.quizapp.client.controller.teacher.BatchController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <Label text="Create Batch" />
    <TextField fx:id="programField" maxWidth="320" promptText="Program, e.g. BSCS" />
    <TextField fx:id="entryYearField" maxWidth="320" promptText="Entry year, e.g. 2024" />
    <Button mnemonicParsing="false" onAction="#handleCreateBatch" text="Create batch" />
    <ListView fx:id="batchListView" maxHeight="220" maxWidth="420" prefHeight="200" prefWidth="420" />
    <Button mnemonicParsing="false" onAction="#handleBack" text="Back" />
    <Label fx:id="statusLabel" wrapText="true" />
</VBox>
